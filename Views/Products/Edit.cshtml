@model OrderSystem.Models.Product

@{
    ViewData["Title"] = "Редагувати товар";
}

<section class="product-form-page">

    <div class="form-container">

        <a asp-action="Index" class="back-link">
            ← Назад
        </a>

        <h1>Редагувати оголошення</h1>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="form-group">
                <label asp-for="Game"></label>
                <input asp-for="Game" />
                <span asp-validation-for="Game"></span>
            </div>

            <div class="form-group">
                <label asp-for="Category"></label>

                <select asp-for="Category" asp-items="Html.GetEnumSelectList<ProductCategory>()">
                    <option value="">Оберіть категорію</option>
                </select>

                <span asp-validation-for="Category"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price"></label>
                <input asp-for="Price" type="number" min="0" max="100000" step="0.01" />
                <span asp-validation-for="Price"></span>
            </div>

            <div class="form-group">
                <label asp-for="SellerName"></label>
                <input asp-for="SellerName" />
                <span asp-validation-for="SellerName"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="5"></textarea>
                <small class="catalog-note">Необов’язково. Від 3 до 500 символів; додайте деталі, яких немає в назві.</small>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="checkbox-group">
                <input asp-for="IsAvailable" />
                <label asp-for="IsAvailable"></label>
            </div>

            <button type="submit" class="main-button">
                Зберегти зміни
            </button>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}