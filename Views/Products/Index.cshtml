@model OrderSystem.Models.ProductCatalogViewModel

@{
    ViewData["Title"] = "Каталог";
}

<section class="products-page">

    <div class="products-header">
        <div>
            <span class="page-label">Marketplace</span>
            <h1>Каталог</h1>
            <p>Пропозиції користувачів GameTrade UA</p>
        </div>

        <a asp-action="Create" class="main-button">
            + Створити оголошення
        </a>
    </div>

    <p class="catalog-note">Демонстраційний каталог. Зміни зберігаються до перезапуску сервера.</p>
    <form asp-controller="Products" asp-action="Index" method="get" class="catalog-filters">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <div class="filter-grid">
            <div class="form-group">
                <label for="Search">Назва оголошення</label>
                <input id="Search" name="Search" value="@Model.Filter.Search" placeholder="Що шукаєте?" />
            </div>
            <div class="form-group">
                <label for="Game">Гра</label>
                <select id="Game" name="Game">
                    <option value="">Усі ігри</option>
                    @foreach (var game in Model.Games)
                    {
                        <option value="@game" selected="@(Model.Filter.Game == game)">@game</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="Category">Категорія</label>
                <select id="Category" name="Category">
                    <option value="">Усі категорії</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category" selected="@(Model.Filter.Category == category)">@category</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="MinPrice">Ціна від, грн</label>
                @Html.TextBox("MinPrice", Model.Filter.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture), new { type = "number", min = "0", max = "1000000", step = "0.01" })
            </div>
            <div class="form-group">
                <label for="MaxPrice">Ціна до, грн</label>
                @Html.TextBox("MaxPrice", Model.Filter.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture), new { type = "number", min = "0", max = "1000000", step = "0.01" })
            </div>
        </div>
        <div class="filter-actions">
            <label class="checkbox-group" for="OnlyAvailable">
                <input type="checkbox" id="OnlyAvailable" name="OnlyAvailable" value="true" checked="@Model.Filter.OnlyAvailable" /> Лише доступні
            </label>
            <button class="main-button" type="submit">Знайти</button>
            <a asp-controller="Products" asp-action="Index" class="secondary-button">Скинути фільтри</a>
        </div>
    </form>
    <p class="catalog-note">Знайдено оголошень: @Model.Products.Count</p>
    @if (!Model.Products.Any())
    {
        <p class="empty-state">За цими умовами оголошень немає. Змініть або скиньте фільтри.</p>
    }
    <div class="products-grid">

        @foreach (var product in Model.Products)
        {
            <div class="product-card">

                <div class="product-top">
                    <span class="product-game">@product.Game</span>

                    @if (product.IsAvailable)
                    {
                        <span class="product-status available">
                            Доступний
                        </span>
                    }
                    else
                    {
                        <span class="product-status unavailable">
                            Недоступний
                        </span>
                    }
                </div>

                <h2>@product.Name</h2>

                <p class="product-category">
                    @product.Category
                </p>

                <div class="product-seller">
                    Продавець: @product.SellerName
                </div>

                <div class="product-bottom">

                    <strong>
                        @product.Price.ToString("0.00") ₴
                    </strong>

                    <div class="product-actions">

                        <a asp-action="Details"
                           asp-route-id="@product.Id">
                            Деталі
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@product.Id">
                            Редагувати
                        </a>

                        <a asp-action="Delete" asp-route-id="@product.Id">Видалити</a>
                    </div>

                </div>

            </div>
        }

    </div>

</section>