@model OrderSystem.Models.DirectoryViewModel<Customer>
@{ ViewData["Title"] = "Покупці"; }
<section class="products-page">
    <div class="products-header"><h1>Покупці</h1><a asp-action="Create" class="main-button">Додати</a></div>
    <form method="get" asp-action="Index" class="catalog-filters">
        <div class="filter-grid">
            <div class="form-group"><label for="search">Пошук за іменем</label><input id="search" name="search" value="@Model.Search" /></div>
            <div class="form-group"><label for="sort">Сортування</label><select id="sort" name="sort">
            @foreach (var option in new[] { ("name", "За іменем / прізвищем ↑"), ("name_desc", "За іменем / прізвищем ↓"), ("city", "За містом ↑"), ("city_desc", "За містом ↓") })
            { <option value="@option.Item1" selected="@(Model.Sort == option.Item1)">@option.Item2</option> }
            </select></div>
        </div>
        <div class="filter-actions"><button class="main-button">Застосувати</button><a asp-action="Index" class="secondary-button">Скинути</a></div>
    </form>
    <div class="table-container"><table class="users-table"><thead><tr><th>Ім’я / назва</th><th>Місто</th><th>Дії</th></tr></thead><tbody>
    @foreach (var item in Model.Items)
    { <tr><td>@item.FullName</td><td>@item.City</td><td><a asp-action="Details" asp-route-id="@item.Id">Деталі</a> · <a asp-action="Edit" asp-route-id="@item.Id">Редагувати</a> · <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a></td></tr> }
    </tbody></table></div>
    @if (Model.Items.Count == 0) { <p>Записів не знайдено.</p> }
    <nav aria-label="Сторінки" class="filter-actions">
        @if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" class="secondary-button">← Назад</a> }
        <span>Сторінка @Model.Page з @Model.Pages</span>
        @if (Model.Page < Model.Pages) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" class="secondary-button">Далі →</a> }
    </nav>
</section>
