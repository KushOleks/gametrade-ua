@model OrderSystem.Models.Order
@{ ViewData["Title"] = "Видалити замовлення"; }
<section class="product-details"><div class="details-card"><h1>Видалити замовлення №@Model.Id?</h1><p>Покупець: @Model.Customer.FullName. Разом: @Model.Total.ToString("0.00") ₴</p>
<form asp-action="Delete" method="post"><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div><button class="danger-button">Видалити</button><a asp-action="Details" asp-route-id="@Model.Id" class="secondary-button">Скасувати</a></form></div></section>
