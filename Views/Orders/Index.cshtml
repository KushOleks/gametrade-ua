@model IReadOnlyList<OrderSystem.Models.Order>
@{ ViewData["Title"] = "Замовлення"; }
<section class="products-page">
<div class="products-header"><h1>Замовлення</h1><a asp-action="Create" class="main-button">Створити замовлення</a></div>
<p class="catalog-note">Навчальний облік замовлень без оплати. Ціни зберігаються на момент оформлення.</p>
<div class="table-container"><table class="users-table"><thead><tr><th>№</th><th>Дата (UTC)</th><th>Покупець</th><th>Продавець</th><th>Сума</th><th>Дії</th></tr></thead><tbody>
@foreach (var order in Model)
{ <tr><td>@order.Id</td><td>@order.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td><td>@order.Customer.FullName</td><td>@order.Seller.Name</td><td>@order.Total.ToString("0.00") ₴</td><td><a asp-action="Details" asp-route-id="@order.Id">Деталі</a> · <a asp-action="Edit" asp-route-id="@order.Id">Редагувати</a> · <a asp-action="Delete" asp-route-id="@order.Id">Видалити</a></td></tr> }
</tbody></table></div>
@if (Model.Count == 0) { <p>Замовлень ще немає.</p> }
</section>
